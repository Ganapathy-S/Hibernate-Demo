CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE SEQUENCE HIBERNATE_SEQUENCE AS INTEGER START WITH 0 
CREATE MEMORY TABLE CARS(CAR_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,CAR_NAME VARCHAR(255),PRICE INTEGER)
CREATE MEMORY TABLE BOOKS(BOOK_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,BOOK_NAME VARCHAR(255),BOOKD_PRICE INTEGER)
CREATE MEMORY TABLE FRIENDS(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,AGE INTEGER,FRIEND_NAME VARCHAR(255))
CREATE MEMORY TABLE ACCOUNT(ACCOUNT_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,ACCOUNT_TYPE VARCHAR(255),USER_ID BIGINT NOT NULL)
CREATE MEMORY TABLE ADDRESS(ADDRESS_ID BIGINT NOT NULL PRIMARY KEY,STREET VARCHAR(255),ZIPCODE VARCHAR(255),CITY VARCHAR(255))
CREATE MEMORY TABLE BUYER(BUYER_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,BUYER_NAME VARCHAR(255))
CREATE MEMORY TABLE COUNTRIES(TOURIST_ID BIGINT NOT NULL,COUNTRY VARCHAR(255) NOT NULL,BAG_TABLE_ID VARCHAR(255) NOT NULL PRIMARY KEY)
CREATE MEMORY TABLE COURSES(COURSE_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,COURSE_NAME VARCHAR(255))
CREATE MEMORY TABLE CUSTOMERS(CUSTOMER_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,NAME VARCHAR(255),HOME_STREET VARCHAR(255) NOT NULL,HOME_CITY VARCHAR(255) NOT NULL,HOME_ZIPCODE VARCHAR(255) NOT NULL,BILLING_STREET VARCHAR(255) NOT NULL,BILLING_CITY VARCHAR(255) NOT NULL,BILLING_ZIPCODE VARCHAR(255) NOT NULL)
CREATE MEMORY TABLE EMPLOYEES(EMP_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,EMP_NAME VARCHAR(255),AGE INTEGER,SALARY INTEGER)
CREATE MEMORY TABLE EXAMS(EXAM_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,EXAM_NAME VARCHAR(255))
CREATE MEMORY TABLE FILES(FOLDER_ID BIGINT NOT NULL,FILENAME VARCHAR(255) NOT NULL,PRIMARY KEY(FOLDER_ID,FILENAME))
CREATE MEMORY TABLE FOLDERS(FOLDER_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,FOLDER_NAME VARCHAR(255))
CREATE MEMORY TABLE HELLO(HELLO_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,NAME VARCHAR(255),MESSAGE VARCHAR(255))
CREATE MEMORY TABLE MEMBERS(LEADER_ID BIGINT NOT NULL,MEMBER_NAME VARCHAR(255) NOT NULL,ORDER_ID INTEGER NOT NULL,PRIMARY KEY(LEADER_ID,ORDER_ID))
CREATE MEMORY TABLE PASSPORT(PASSPORT_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,PASSPORT_NUMBER VARCHAR(255))
CREATE MEMORY TABLE PASSPORTS(PERSON_ID BIGINT NOT NULL,PASSPORT_ID BIGINT NOT NULL PRIMARY KEY,CONSTRAINT SYS_CT_46937 UNIQUE(PASSPORT_ID),CONSTRAINT FK6E630681F5B4D85 FOREIGN KEY(PASSPORT_ID) REFERENCES PASSPORT(PASSPORT_ID))
CREATE MEMORY TABLE PERSON(PERSON_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,NAME VARCHAR(255))
CREATE MEMORY TABLE PHOTO(PHOTO_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,FILE_NAME VARCHAR(255),USER_ID BIGINT,CONSTRAINT SYS_CT_46943 UNIQUE(USER_ID))
CREATE MEMORY TABLE PROPERTY(PROPERTY_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,PROPERTY_NAME VARCHAR(255),PROPERTY_VALUE VARCHAR(255))
CREATE MEMORY TABLE PROPERTY_BUYER(PROPERTY_ID BIGINT NOT NULL,BUYER_ID BIGINT NOT NULL,PRIMARY KEY(BUYER_ID,PROPERTY_ID),CONSTRAINT SYS_CT_46949 UNIQUE(PROPERTY_ID),CONSTRAINT FK581BC6A999B22DA6 FOREIGN KEY(PROPERTY_ID) REFERENCES PROPERTY(PROPERTY_ID),CONSTRAINT FK581BC6A9C5AE044E FOREIGN KEY(BUYER_ID) REFERENCES BUYER(BUYER_ID))
CREATE MEMORY TABLE RECRUITMENTS(RCRMT_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,RCRMT_NAME VARCHAR(255))
CREATE MEMORY TABLE REJECTED_LIST(RCRMT_ID BIGINT NOT NULL,NAME VARCHAR(255),AGE INTEGER,QUALIFICATION VARCHAR(255),EXPERIECE VARCHAR(255),CONSTRAINT FKFA027BBF8D461989 FOREIGN KEY(RCRMT_ID) REFERENCES RECRUITMENTS(RCRMT_ID))
CREATE MEMORY TABLE SELECTED_LIST(RCRMT_ID BIGINT NOT NULL,NAME VARCHAR(255),AGE INTEGER,QUALIFICATION VARCHAR(255),EXPERIECE VARCHAR(255),CONSTRAINT FK124EE7C28D461989 FOREIGN KEY(RCRMT_ID) REFERENCES RECRUITMENTS(RCRMT_ID))
CREATE MEMORY TABLE STUDENTS(STUDENT_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,STUDENT_NAME VARCHAR(255))
CREATE MEMORY TABLE STUDENT_COURSE(STUDENT_ID BIGINT NOT NULL,COURSE_ID BIGINT NOT NULL,PRIMARY KEY(STUDENT_ID,COURSE_ID),CONSTRAINT FKCB6FBEBFC4079D18 FOREIGN KEY(STUDENT_ID) REFERENCES STUDENTS(STUDENT_ID),CONSTRAINT FKCB6FBEBF3BD7FEDC FOREIGN KEY(COURSE_ID) REFERENCES COURSES(COURSE_ID))
CREATE MEMORY TABLE TEAM_LEADER(LEADER_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,LEADER_NAME VARCHAR(255))
CREATE MEMORY TABLE TIME_TABLE(EXAM_ID BIGINT NOT NULL,EXAM_DATE DATE,SUBJECT VARCHAR(255) NOT NULL,PRIMARY KEY(EXAM_ID,SUBJECT),CONSTRAINT FK973FE3BC6DF29023 FOREIGN KEY(EXAM_ID) REFERENCES EXAMS(EXAM_ID))
CREATE MEMORY TABLE TOURS(TOURIST_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,TOURIST_NAME VARCHAR(255),NUMBER_OF_TRAVELS INTEGER)
CREATE MEMORY TABLE USER(USER_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,NAME VARCHAR(255))
ALTER TABLE ACCOUNT ADD CONSTRAINT FKE49F160D7406E6A7 FOREIGN KEY(USER_ID) REFERENCES USER(USER_ID)
ALTER TABLE ADDRESS ADD CONSTRAINT FKE66327D42FE8C421 FOREIGN KEY(ADDRESS_ID) REFERENCES USER(USER_ID)
ALTER TABLE COUNTRIES ADD CONSTRAINT FKF6B7AA94F3E6C33D FOREIGN KEY(TOURIST_ID) REFERENCES TOURS(TOURIST_ID)
ALTER TABLE FILES ADD CONSTRAINT FK3FCC2578B5481BD FOREIGN KEY(FOLDER_ID) REFERENCES FOLDERS(FOLDER_ID)
ALTER TABLE MEMBERS ADD CONSTRAINT FK635A54F99A939410 FOREIGN KEY(LEADER_ID) REFERENCES TEAM_LEADER(LEADER_ID)
ALTER TABLE PASSPORTS ADD CONSTRAINT FK6E63068188192965 FOREIGN KEY(PERSON_ID) REFERENCES PERSON(PERSON_ID)
ALTER TABLE PHOTO ADD CONSTRAINT FK48946129D2451BC FOREIGN KEY(USER_ID) REFERENCES USER(USER_ID)
ALTER TABLE CARS ALTER COLUMN CAR_ID RESTART WITH 5
ALTER TABLE BOOKS ALTER COLUMN BOOK_ID RESTART WITH 1
ALTER TABLE FRIENDS ALTER COLUMN ID RESTART WITH 1
ALTER TABLE ACCOUNT ALTER COLUMN ACCOUNT_ID RESTART WITH 1
ALTER TABLE BUYER ALTER COLUMN BUYER_ID RESTART WITH 1
ALTER TABLE COURSES ALTER COLUMN COURSE_ID RESTART WITH 1
ALTER TABLE CUSTOMERS ALTER COLUMN CUSTOMER_ID RESTART WITH 1
ALTER TABLE EMPLOYEES ALTER COLUMN EMP_ID RESTART WITH 1
ALTER TABLE EXAMS ALTER COLUMN EXAM_ID RESTART WITH 1
ALTER TABLE FOLDERS ALTER COLUMN FOLDER_ID RESTART WITH 1
ALTER TABLE HELLO ALTER COLUMN HELLO_ID RESTART WITH 3
ALTER TABLE PASSPORT ALTER COLUMN PASSPORT_ID RESTART WITH 1
ALTER TABLE PERSON ALTER COLUMN PERSON_ID RESTART WITH 1
ALTER TABLE PHOTO ALTER COLUMN PHOTO_ID RESTART WITH 1
ALTER TABLE PROPERTY ALTER COLUMN PROPERTY_ID RESTART WITH 1
ALTER TABLE RECRUITMENTS ALTER COLUMN RCRMT_ID RESTART WITH 1
ALTER TABLE STUDENTS ALTER COLUMN STUDENT_ID RESTART WITH 1
ALTER TABLE TEAM_LEADER ALTER COLUMN LEADER_ID RESTART WITH 1
ALTER TABLE TOURS ALTER COLUMN TOURIST_ID RESTART WITH 1
ALTER TABLE USER ALTER COLUMN USER_ID RESTART WITH 1
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 10
SET SCHEMA PUBLIC
